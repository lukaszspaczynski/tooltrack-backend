{
  "name": "tooltrack-backend",
  "version": "0.1.0",
  "description": "ToolTrack Node API for the construction tool catalog, backed by raw Postgres schemas.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "db:adminer": "docker compose --profile tools up -d adminer",
    "db:adminer:down": "docker compose --profile tools stop adminer",
    "db:down": "docker compose --profile tools down",
    "db:up": "docker compose up -d postgres",
    "db:schema:apply": "tsx scripts/apply-db-schema.ts",
    "dev": "tsx watch src/server/index.ts",
    "dev:debug": "tsx watch --inspect src/server/index.ts",
    "format": "prettier --write .",
    "lint": "npm run typecheck",
    "photos:png": "tsx scripts/convert-photos-to-png.ts",
    "qbrick:import": "tsx scripts/import-qbrick-tools.ts",
    "start": "tsx src/server/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --pretty false",
    "user:admin": "tsx scripts/ensure-admin-user.ts",
    "qbrick:cases": "tsx scripts/import-qbrick-cases.ts"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "16.4.7",
    "pdf-lib": "^1.17.1",
    "pg": "8.20.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
