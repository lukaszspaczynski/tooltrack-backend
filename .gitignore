# dependencies
/node_modules

# build output
/dist

# misc
.DS_Store
# A blanket rule, because a .pem here is otherwise somebody's private key.
*.pem
# Except this one, which is a public CA certificate and has to ship: without it
# the container has nothing for NODE_EXTRA_CA_CERTS to point at. See the README
# beside it.
!/assets/certs/*.pem

# debug
npm-debug.log*

# typescript
*.tsbuildinfo

# local env files
.env
.env*.local

# Local Postgres data
/.local/

# Local credentials for docs/api.http — never in the repository.
docs/api.local.http
