{
  "version": "2.0.0",
  "tasks": [
    {
      // Cmd+Shift+B. The $tsc matcher puts the errors in the Problems panel.
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "format",
      "type": "npm",
      "script": "format",
      "problemMatcher": []
    },
    {
      // Watch mode: restarts the server on every save. Debugging is the
      // "API: debug server" launch configuration instead.
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      // The one step in this repo that nothing runs for you. Adding a route or
      // changing a Zod schema does not rewrite docs/openapi.json, and the
      // watcher will not notice: the build touches no TypeScript. Run this,
      // then commit the document with the change it describes.
      "label": "openapi: build",
      "type": "npm",
      "script": "openapi:build",
      "problemMatcher": []
    },
    {
      // What `npm run lint` asks before a commit: does the committed document
      // still match the code. Same answer, on its own, when the question is
      // whether anything drifted.
      "label": "openapi: check",
      "type": "npm",
      "script": "openapi:check",
      "problemMatcher": []
    },
    {
      // Swagger UI, served by the API it describes. Reads the document afresh
      // on every request outside production, so a rebuild shows on a refresh
      // rather than needing the server restarted.
      "label": "open: swagger in browser",
      "type": "shell",
      "command": "open http://localhost:37411/api/docs",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "db: up",
      "type": "npm",
      "script": "db:up",
      "problemMatcher": []
    },
    {
      "label": "db: apply schema",
      "type": "npm",
      "script": "db:schema:apply",
      "problemMatcher": []
    },
    {
      "label": "db: down",
      "type": "npm",
      "script": "db:down",
      "problemMatcher": []
    },
    {
      // Starts the Adminer container (and Postgres as its dependency).
      "label": "db: adminer",
      "type": "npm",
      "script": "db:adminer",
      "problemMatcher": []
    },
    {
      // One click from nothing to a table browser. The query string preselects
      // the PostgreSQL driver and fills in server, user and database, so the
      // login form only asks for the password (`tooltrack` locally).
      //
      // ns is the schema Adminer opens on. `public` is where it lands by
      // default and it is empty here — swap it for `catalog` to arrive on the
      // tool cards, or `account` for users and sessions.
      "label": "open: adminer in browser",
      "dependsOn": ["db: adminer"],
      "type": "shell",
      "command": "open 'http://localhost:8080/?pgsql=postgres&username=tooltrack&db=tooltrack&ns=public'",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      // Opens the running API in the default browser. The root path answers
      // 404 with the full route list, which is what you want to look at when
      // the question is "is it up, and what does it serve" — /api/version and
      // /healthz are linked from there in docs/api.md.
      "label": "open: status in browser",
      "type": "shell",
      "command": "open http://localhost:37411",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      // What a fresh checkout needs before anything works: database up, schema
      // applied, then the watching server.
      "label": "start local stack",
      "dependsOrder": "sequence",
      "dependsOn": ["db: up", "db: apply schema", "dev"],
      "problemMatcher": []
    }
  ]
}
